# Deploy configuration for marstek_venus_ha
# Copy this file to deploy.config.ps1 and fill in your values.
# deploy.config.ps1 is gitignored — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────

# UNC path to the custom_components folder on the network share
$HA_SHARE_PATH = "\\LOXBERRY2\Home Assistant\custom_components"

# ── Optional: REST API restart ────────────────────────────────────────────────
# If both are set, the script will call the HA REST API to restart after deploy.
# Leave blank (or remove) to skip automatic restart.

# Base URL of your Home Assistant instance
$HA_API_URL = "http://homeassistant.local:8123"   # or e.g. "http://192.168.1.50:8123"

# Long-lived access token
# Generate one in HA: Profile → Security → Long-lived access tokens → Create token
$HA_TOKEN = ""
